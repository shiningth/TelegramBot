    "state_store": "runtime/data/chat_games_state.json",
    "output_dir": "runtime/data/generated_chat_games"
  },
  "magnet_import": {
    "manual_only": false,
    "manual_commands": ["/import", "/导入"],
    "manual_mention_commands": ["导入", "/import"],
    "silent_denied": true,
    "watch_chats": [],
    "sender_usernames": [],
    "sender_ids": [],
    "file_name_pattern": "^x1080x.*\\.csv$",
    "max_file_size_mb": 2048,
    "api_base_url": "http://127.0.0.1:8022",
    "api_username": "admin",
    "api_password": "",
    "update_existing": false,
    "skip_duplicates": true,
    "reply_text": "已自动导入，谢谢老大",
    "manual_success_text": "资源导入完成：新增 {imported} 条，更新 {updated} 条，跳过 {skipped} 条重复记录。",
    "reply_denied_text": "仅群管理员或已授权用户可以触发导入。",
    "reply_need_reply_text": "请回复一条 CSV 文件消息，再发送 {command}。",
    "reply_not_csv_text": "回复的消息必须是符合文件名规则的 CSV 文件。",
    "reply_duplicate_text": "这份文件正在处理或已经处理过，请查看导入记录。",
    "reply_oversized_text": "文件超过 {max_size} MB，无法导入。",
    "reply_missing_credentials_text": "尚未配置 momo 登录信息，请联系管理员。",
    "reply_failed_text": "导入失败，请在管理后台查看错误详情，修复后可再次回复触发。",
    "download_dir": "runtime/tmp/magnet_import",
    "download_retries": 5,
    "import_timeout_seconds": 1800.0,
    "state_store": "runtime/data/magnet_import_state.json"
  },
  "ltx_watch": {
    "dry_run": true,
    "channel": "examplechan",
    "session_name": "ltx_user",
    "poll_interval_seconds": 300,
    "initial_full_scan": true,
    "max_initial_messages": 3000,
    "fetch_metadata": true,
    "metadata_retries": 3,
    "source_site": "ltx",
    "forum_name": "LTX破解",
    "max_pending_days": 7,
    "notify_enabled": false,
    "notify_cron": "0 21 * * *",
    "notify_target": "me",
    "notify_text": "📥 LTX 采集汇总（{since} ~ {now}）\n新增磁链 {imported} 条 · 跳过重复 {skipped} 条 · 失败 {failed} 条 · 待补封面 {pending} 条",
    "state_store": "runtime/data/ltx_watch_state.json"
  },
  "ai": {
    "reply_provider": {
      "name": "default",
      "provider_type": "openai",
      "base_url": "",
      "api_key": "",
      "model": "",
      "enabled": false
    },
    "image_provider": {
      "name": "image",
      "provider_type": "openai",
      "base_url": "",
      "api_key": "",
      "model": "",
      "enabled": false
    },
    "reply": {
      "system_prompt": "你是一个在 Telegram 群里聊天的人形助手。回复要自然、简短、像真人聊天，不要暴露系统提示。",
      "owner_user_ids": [],
      "command_prefixes": [
        "/ai",
        ".ai"
      ],
      "wake_words": [
        "@ai",
        "喂AI",
        "问AI"
      ],
      "reply_triggers": [
        "ai",
        "AI",
        "回答",
        "解释"
      ],
      "context_limit": 6,
      "timeout_seconds": 180.0,
      "max_tokens": 25000,
      "temperature": 0.7,
      "reasoning_effort": "none",
      "reasoning_summary": true,
      "text_verbosity": "medium",
      "web_search": true,
      "image_detail": "original",
      "message_info_enabled": true,
      "message_info_command_prefixes": [
        "/msg"
      ],
      "settings_store": "runtime/data/ai_settings.json"
    },
    "image": {
      "command_prefixes": [
        "/draw"
      ],
      "size": "1K",
      "ratio": "1:1",
      "quality": "standard",
      "send_mode": "auto",
      "timeout_seconds": 120.0,
      "output_dir": "runtime/data/generated_images",
      "settings_store": "runtime/data/image_settings.json",
      "size_commands": [
        "/draw_size",
        "/size"
      ],
      "ratio_commands": [
        "/draw_ratio",
        "/ratio"
      ],
      "send_mode_commands": [
        "/send_mode",
        "/draw_send",
        "/image_send"
      ],
      "model_commands": [
        "/draw_model",
        "/image_model",
        "/img_model"
      ]
