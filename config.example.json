{
  "project_name": "TelegramBot",
  "version": "0.1.0",
  "admin": {
    "host": "127.0.0.1",
    "port": 8088,
    "username": "",
    "password": ""
  },
  "telegram": {
    "enabled": false,
    "api_id": null,
    "api_hash": "",
    "bot_token": "",
    "session_name": "telegram_bot",
    "session_dir": "sessions",
    "monitored_groups": [],
    "monitored_group_meta": {}
  },
  "logs": {
    "level": "INFO",
    "dir": "runtime/logs",
    "file_name": "telegram-bot.log",
    "max_bytes": 5242880,
    "max_files": 5
  },
  "runtime": {
    "data_dir": "runtime/data",
    "tmp_dir": "runtime/tmp"
  },
  "chat_history": {
    "enabled": true,
    "database_path": "runtime/data/chat_history.sqlite3",
    "max_text_length": 16384,
    "backfill_enabled": false,
    "backfill_batch_size": 500
  },
  "modules": {
    "red_packet": false,
    "send_red_packet": false,
    "ai_reply": false,
    "ai_image": false,
    "ai_decrypt": false,
    "gif": false,
    "checkin": false,
    "site_checkin": false,
    "auto_forward": false,
    "word_cloud": false,
    "user_profile": false,
    "quote": false,
    "chat_games": false,
    "magnet_import": false
  },
  "red_packet": {
    "templates": [],
    "send_delay_ms": 0,
    "pre_click_messages": []
  },
  "send_red_packet": {
    "templates": [
      {
        "id": "lucky-text",
        "name": "拼手气红包",
        "type": "lucky_text",
        "enabled": true,
        "command_prefixes": [
          "红包",
          "/红包"
        ],
        "max_packet_count": 100
      },
      {
        "id": "math-quiz",
        "name": "趣味算术题",
        "type": "math_quiz",
        "enabled": true,
        "command_prefixes": [
          "/math"
        ],
        "max_packet_count": 1
      }
    ],
    "state_store": "runtime/data/send_red_packet_state.json",
    "id_length": 6,
    "max_active_packets": 20,
    "min_packet_amount": 2,
    "strict_min_packet_amount": 101,
    "strict_min_packet_group_ids": []
  },
  "ai_decrypt": {
    "templates": [
      {
        "id": "dice-grid",
        "name": "九宫格骰子竞猜",
        "enabled": true,
        "trigger_keywords": [
          "九宫格骰子竞猜",
          "目标点数"
        ],
        "id_markers": [],
        "require_media": true,
        "prompt": ""
      },
      {
        "id": "qingwa-math-passphrase",
        "name": "QingWA 数学口令红包",
        "enabled": true,
        "trigger_keywords": [
          "请识别图片中的口令",
          "红包ID",
          "数学题"
        ],
        "id_markers": [
          "红包ID:",
          "红包ID："
        ],
        "require_media": true,
        "prompt": ""
      },
      {
        "id": "twenty-four-points",
        "name": "24 点算式",
        "enabled": true,
        "trigger_keywords": [
          "24 点开始",
          "数字：",
          "可用符号"
        ],
        "id_markers": [],
        "require_media": false,
        "prompt": ""
      }
    ],
    "timeout_seconds": 120.0,
    "max_tokens": 512,
    "image_detail": "original",
    "send_delay_ms": 0,
    "state_store": "runtime/data/ai_decrypt_claimed_ids.json"
  },
  "gif": {
    "command_prefixes": [
      "/vgif",
      "动图",
      "视频动图",
      "转动图"
    ],
    "output_dir": "runtime/data/generated_gifs",
    "max_seconds": 8.0,
    "fps": 12,
    "width": "auto",
    "max_bytes": 8388608
  },
  "checkin": {
    "user_session_name": "",
    "user_id": "",
    "tasks": [],
    "poll_interval_seconds": 10.0,
    "state_store": "runtime/data/checkin_state.json"
  },
  "site_checkin": {
    "enabled": false,
    "poll_interval_seconds": 30,
    "timeout_seconds": 40,
    "log_keep_days": 30,
    "flaresolverr": "",
    "notify_enabled": true,
    "notify_bot_token": "",
    "notify_chat_id": "",
    "notify_text": "站点签到 · {name}\n{status}：{reason}\n时间：{time}",
    "state_store": "runtime/data/site_checkin_state.json",
    "sites": [
      {
        "id": "ourbits",
        "name": "OurBits",
        "enabled": true,
        "url": "https://ourbits.club/attendance.php",
        "cookie": "ourbits_jwt=...",
        "cron": "10 8 * * *",
        "method": "auto",
        "sign_url": "",
        "post_data": "",
        "headers": "",
        "success_keywords": "",
        "already_keywords": "",
        "note": ""
      }
    ]
  },
  "auto_forward": {
    "command_prefixes": [
      ",re"
    ],
    "copy_text_command_prefixes": [
      ",copy"
    ],
    "quote_command_prefixes": [
      ",quote"
    ],
    "link_command_prefixes": [
      ",link"
    ],
    "delete_command": true
  },
  "word_cloud": {
    "command_prefixes": [
      "cy",
      "/cy"
    ],
    "default_limit": 1000,
    "max_limit": 2000,
    "min_limit": 50,
    "output_dir": "runtime/data/generated_word_clouds",
    "width": 900,
    "height": 640,
    "delete_command": true,
    "ignore_command_prefixes": [
      "/",
      ".",
      ","
    ],
    "stop_words": []
  },
  "user_profile": {
    "command_prefixes": [
      "/profile",
      "/fx",
      ".fx",
      "画像",
      "用户画像"
    ],
    "default_sample_size": 40,
    "min_sample_size": 10,
    "max_sample_size": 2000,
    "min_required_samples": 8,
    "timeout_seconds": 180.0,
    "max_tokens": 4000,
    "delete_command": false,
    "style_prompt": "像熟悉群聊黑话的损友一样写：毒舌、有梗、敢吐槽，允许适度夸张、反差和好笑的外号，少说四平八稳的套话。每个笑点仍要能在样本中找到依据；可以损，但不要恶意羞辱、攻击外貌，也不要触碰敏感属性或把娱乐性观察写成事实诊断。"
  },
  "quote": {
    "command_prefixes": [
      "/q",
      "语录"
    ],
    "api_url": "https://quote-api-enhanced.zhetengsha.eu.org/generate.webp",
    "background_color": "#1b1429",
    "width": 512,
    "height": 768,
    "scale": 2,
    "emoji_brand": "apple",
    "max_messages": 5,
    "timeout_seconds": 60.0,
    "sticker_set_short_name": "",
    "tmp_dir": "runtime/tmp"
  },
